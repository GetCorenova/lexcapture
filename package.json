{
  "name": "lexcapture",
  "version": "8.0.0",
  "description": "LexCapture — registro de capturas y generación de documentos legales en campo. PWA autónoma (un solo HTML), offline-first, con envoltorio nativo Android que lleva el código dentro del paquete.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:web:check": "node scripts/build-web.mjs --check",
    "build:android": "node scripts/build-android.mjs",
    "build:android:check": "node scripts/build-android.mjs --check",
    "gen:icons": "node scripts/gen-icons.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "deploy:web": "node scripts/deploy-web.mjs",
    "deploy:playstore": "node scripts/deploy-playstore.mjs",
    "formatos": "node scripts/admin-formatos.mjs",
    "build:pdfjs": "node scripts/build-pdfjs.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/build-web.mjs --check",
    "store:assets": "node scripts/store-assets.mjs",
    "store:feature": "node scripts/store-feature.mjs"
  },
  "keywords": [
    "pwa",
    "offline-first",
    "capacitor"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "esbuild": "0.28.2",
    "firebase": "12.19.0",
    "firebase-admin": "13.10.0",
    "firebase-tools": "15.32.1",
    "pdfjs-dist": "6.3.289",
    "playwright": "^1.61.0"
  }
}
