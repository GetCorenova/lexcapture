rules_version = '2';

// Reglas de Firestore de FLAGRANTE.
//
// Firestore solo guarda SOBRES CIFRADOS: la llave de los datos (DEK) se cifra
// en el teléfono antes de salir, con una llave que sale de la contraseña del
// usuario (que Firebase nunca recibe) o con su código de recuperación. Estas
// reglas deciden QUIÉN puede leer y escribir esos sobres; lo que contienen no
// lo puede leer nadie más que el dueño, aunque las reglas fallaran.
//
// F2 (cuenta): users/{uid}/llaves/main.
// F3 (derecho de uso): entitlements/{uid}. Solo lo escriben las funciones del
// servidor (el SDK de administración no pasa por estas reglas): el teléfono lo
// lee y nunca lo escribe — si pudiera, se regalaría la prueba.
// F4 (nube): users/{uid}/reg/{id}, un registro por documento.
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Un sobre cifrado en base64: texto, y nunca enorme.
    function sobre(v) {
      return v is string && v.size() > 20 && v.size() < 400;
    }

    // ¿La cuenta tiene derecho de uso vigente? Lo dice entitlements/{uid}, que
    // solo escribe el servidor. El plan pagado tiene los mismos 3 días de gracia
    // que da la app (cubren el retraso de la renovación).
    function vigente(uid) {
      let ruta = /databases/$(database)/documents/entitlements/$(uid);
      return exists(ruta) && (
        get(ruta).data.vence > request.time ||
        (get(ruta).data.plan == 'pagado' && get(ruta).data.vence + duration.value(3, 'd') > request.time));
    }

    match /users/{uid}/llaves/{id} {
      allow read, delete: if esDueno(uid) && id == 'main';
      allow create, update: if esDueno(uid) && id == 'main'
        && request.resource.data.keys().hasOnly(['v', 'kdf', 'dekClave', 'dekRec', 'dekClaveNueva', 'act'])
        && request.resource.data.keys().hasAll(['v', 'dekClave', 'dekRec'])
        && sobre(request.resource.data.dekClave)
        && sobre(request.resource.data.dekRec)
        && (!('dekClaveNueva' in request.resource.data) || sobre(request.resource.data.dekClaveNueva));
    }

    // ── LOS REGISTROS (F4) ────────────────────────────────────────────────
    // Uno por captura, persona, firma y la configuración. El nombre del
    // documento es un HMAC que calcula el teléfono: no dice qué es ni de quién.
    // Lo único legible es el número de versión, la hora del servidor y si es un
    // borrado; el contenido (y el tipo, y el identificador real) va dentro de
    // `ct`, cifrado con la DEK.
    //
    // · Leer y borrar: siempre el dueño. Leer aunque el plan haya vencido, para
    //   que pueda bajar y exportar lo suyo (es su información). Borrar lo usa
    //   «empezar de cero» sin código: lo de antes ya no lo abre nadie.
    // · Escribir: el dueño CON derecho de uso vigente, y con la versión
    //   siguiente a la que hay (1 si no existe). Es un «comparar y cambiar»:
    //   dos equipos que escriben la misma versión no se pisan; el segundo es
    //   rechazado, baja lo del primero, lo funde y vuelve a subir.
    function registro() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'rev', 'updatedAt', 'borrado', 'ct'])
        && d.keys().hasAll(['v', 'rev', 'updatedAt', 'borrado', 'ct'])
        && d.v == 1
        && d.rev is int
        && d.borrado is bool
        && d.updatedAt == request.time
        && d.ct is string && d.ct.size() > 20 && d.ct.size() < 1000000;
    }

    match /users/{uid}/reg/{id} {
      allow read, delete: if esDueno(uid);
      allow create: if esDueno(uid) && id.matches('^r[A-Za-z0-9_-]{27}$') && vigente(uid)
        && registro() && request.resource.data.rev == 1;
      allow update: if esDueno(uid) && vigente(uid)
        && registro() && request.resource.data.rev == resource.data.rev + 1;
    }

    // ── COMPARTIR ENTRE CUENTAS (2026-10-24) ──────────────────────────────
    // La llave de identidad de la cuenta: la pública y la privada cifrada con
    // una llave que sale de la DEK. Solo el dueño la lee y la escribe; a otra
    // cuenta su pública le llega en persona, en el código que escanea.
    match /users/{uid}/llaves/id {
      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['v', 'pub', 'priv', 'act'])
        && request.resource.data.keys().hasAll(['v', 'pub', 'priv'])
        && request.resource.data.v == 1
        && request.resource.data.pub is string && request.resource.data.pub.size() == 88
        && sobre(request.resource.data.priv);
    }

    // El buzón: lo que otra cuenta le deja a esta, cifrado de un teléfono al
    // otro. Cualquiera con sesión puede DEJAR un mensaje firmado con su propio
    // uid (de == quien escribe); solo el dueño del buzón lo lee y lo borra, y
    // nadie lo cambia. Lo que llega de quien no es compañero, la app lo borra
    // sin abrirlo. No exige plan vigente (decisión del usuario).
    function mensaje(mid) {
      let d = request.resource.data;
      return mid.matches('^[A-Za-z0-9_-]{16,40}$')
        && d.keys().hasOnly(['v', 'de', 't', 'ct', 'eph', 'ts'])
        && d.keys().hasAll(['v', 'de', 't', 'ct', 'ts'])
        && d.v == 1
        && d.de == request.auth.uid
        && d.ts == request.time
        && d.t is string && d.t.matches('^[a-z]{2,16}$')
        && d.ct is string && d.ct.size() > 20 && d.ct.size() < 900000
        && (!('eph' in d) || (d.eph is string && d.eph.size() == 88));
    }
    match /buzon/{para}/m/{mid} {
      allow read, delete: if esDueno(para);
      allow create: if request.auth != null && mensaje(mid);
      allow update: if false;
    }

    match /entitlements/{uid} {
      allow read: if esDueno(uid);
      allow write: if false;
    }

    // Todo lo demás, cerrado — también dispositivosPrueba (solo el servidor).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
